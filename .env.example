# FRED (free): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Bank of Korea ECOS (free): https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# 한국부동산원 R-ONE — OPTIONAL, nothing on the dashboard uses it.
# The 한국부동산원 monthly indices come through ECOS on the key above. R-ONE's
# own API (거래량, 전월세전환율, weekly 시군구) needs a key issued by
# 한국부동산원 itself; a data.go.kr key returns ERROR-290.
REB_API_KEY=
